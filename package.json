{
  "name": "mmorpg",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @mmorpg/server",
    "dev:client": "npm run dev -w @mmorpg/client",
    "typecheck": "tsc -b",
    "build": "tsc -b && npm run build -w @mmorpg/client",
    "start": "npm run start -w @mmorpg/server"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.6.0"
  }
}
