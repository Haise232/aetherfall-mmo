# Servidor de Valdoria (lo instala deploy/instalar.sh, que rellena @REPO@ y @USER@).
# Solo escucha en 127.0.0.1: desde Internet se entra únicamente por el túnel de Cloudflare.
[Unit]
Description=Valdoria: servidor del juego
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@/apps/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
# Ajustes propios (por ejemplo MAX_CONN=100) en este archivo opcional:
EnvironmentFile=-/etc/valdoria.env
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM

# ---- Aislamiento: el juego no ve tu carpeta personal ni el resto del sistema ----
# Tu /home queda vacío para él salvo el proyecto (solo lectura) y su carpeta data/ (lectura y escritura).
ProtectHome=tmpfs
BindReadOnlyPaths=@REPO@
BindPaths=@REPO@/apps/server/data
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
